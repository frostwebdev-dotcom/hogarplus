# HogarPlus Solutions — environment template
# Copy to `.env.local` only if you need to OVERRIDE a default.
#
# The business contact details are confirmed (they come from the client's brand
# flyer) and are already baked into `lib/site-config.ts`, so the site renders
# correctly with none of these set. Use these variables for per-environment
# overrides — e.g. a staging domain, or a test phone number.
#
# Every value below is PUBLIC (exposed to the browser). Never put private
# credentials (SMTP passwords, API secrets) in NEXT_PUBLIC_* variables.

# Absolute site origin, no trailing slash. Used for metadataBase, canonical
# URLs, Open Graph and JSON-LD.
# Default: https://www.hogarplussolution.com
NEXT_PUBLIC_SITE_URL=

# Business phone, per language — these are TWO DIFFERENT LINES. The tel: link
# is derived from whichever value applies. Leave blank to use the defaults in
# lib/site-config.ts.
# English default: (908) 540-5734
NEXT_PUBLIC_PHONE_EN=
# Spanish default: (862) 423-3186
NEXT_PUBLIC_PHONE_ES=

# Business email. Used for click-to-email links.
# Default: HogarPlusSolution@gmail.com
NEXT_PUBLIC_EMAIL=

